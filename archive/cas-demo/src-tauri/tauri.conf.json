{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAS Cookie Demo",
  "version": "0.1.0",
  "identifier": "com.proagent.cas-demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SUSTech CAS Cookie Extractor",
        "width": 900,
        "height": 700,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": []
  }
}