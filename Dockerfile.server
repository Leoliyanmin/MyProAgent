FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app/server_backend

COPY server_backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server_backend/ .

RUN mkdir -p logs database/db

EXPOSE 8001

CMD ["sh", "-c", "python database/code/init/database_init.py && uvicorn main:app --host 0.0.0.0 --port 8001"]
