{
  "name": "proagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev.js",
    "dev:concurrent": "concurrently --kill-others --prefix-colors 'blue,green,yellow' --names 'VITE,LOCAL,SERVER' 'vite' 'cd ../local_backend && uvicorn main:app --reload --host 0.0.0.0 --port 8002' 'cd ../server_backend && uvicorn main:app --reload --host 0.0.0.0 --port 8001'",
    "dev:frontend": "vite",
    "dev:local": "concurrently --kill-others --prefix-colors 'blue,green' --names 'VITE,LOCAL' 'vite' 'cd ../local_backend && uvicorn main:app --reload --host 0.0.0.0 --port 8002'",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sidecar:build": "python ../scripts/build_sidecar.py"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "echarts": "^6.0.0",
    "marked": "^18.0.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-router": "^5.0.4",
    "vue3-grid-layout": "^1.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.1",
    "msw": "^2.13.4",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
