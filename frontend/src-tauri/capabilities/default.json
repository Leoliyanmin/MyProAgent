{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for ProAgent",
  "windows": ["main", "cas-login", "cas-login-bb"],
  "permissions": [
    "core:default",
    "store:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/python-backend",
          "sidecar": true
        },
        {
          "name": "binaries/server-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
