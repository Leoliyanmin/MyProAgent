FROM python:3.10-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY server_backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server_backend/ .

RUN mkdir -p /app/logs /app/database/db

EXPOSE 8001

CMD ["sh", "-c", "python database/code/database_init.py && uvicorn main:app --host 0.0.0.0 --port 8001"]
