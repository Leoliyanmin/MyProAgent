FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app/local_backend

COPY local_backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY local_backend/ .
COPY localagent/ /app/localagent/
COPY personality/ /app/personality/

RUN mkdir -p logs database/db

EXPOSE 8002

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/health')" || exit 1

CMD ["sh", "-c", "python database/code/init/database_init.py && uvicorn main:app --host 0.0.0.0 --port 8002"]
