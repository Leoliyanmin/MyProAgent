[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    *.egg-info,
    build,
    dist,
    node_modules

# Pre-existing violations to ignore (to be fixed incrementally)
# Whitespace: W293/W291/W292/W391 (auto-fixable)
# Blank lines: E302/E305 (auto-fixable)
# Line length: E501 (too many to fix at once)
# Import ordering: E402/E401 (often intentional)
# Unused imports/vars: F401/F841 (often test fixtures)
# Minor style: E702/E712/F541/F811/E128/E129
ignore =
    W293,W291,W292,W391,
    E302,E305,E501,
    E402,E401,
    F401,F841,
    E702,E712,F541,F811,
    E128,E129,W503,W504
