# ============================================
# Project Root .gitignore (Merged)
# ============================================

# ----------------------------------------
# Logs
# ----------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------
# Node.js / Frontend
# ----------------------------------------
node_modules
dist
dist-ssr
coverage
*.local

# ----------------------------------------
# Python / Backend
# ----------------------------------------
# Virtual environments
venv/
env/
ENV/
.venv/
.venv

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# ----------------------------------------
# Database files
# ----------------------------------------
*.db
*.sqlite
*.sqlite3

# ----------------------------------------
# Environment variables (sensitive)
# ----------------------------------------
.env
.env.local
.env.*.local

# Keep example files for reference
!.env.example
!**/.env.example

# Backend logs
backend/**/logs/
backend/**/logs

# Database directories
backend/**/database/db/
backend/**/database/code/*.db

# ----------------------------------------
# Editor / IDE
# ----------------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# IntelliJ / PyCharm
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----------------------------------------
# TypeScript / Build
# ----------------------------------------
*.tsbuildinfo
.eslintcache

# ----------------------------------------
# Testing
# ----------------------------------------
# Cypress
/cypress/videos/
/cypress/screenshots/

# Vitest
__screenshots__/

# ----------------------------------------
# Vite
# ----------------------------------------
*.timestamp-*-*.mjs

# ----------------------------------------
# Frontend specific
# ----------------------------------------
# Test files (not for production)
test*.html
test*.js
test-*.html
test-*.js
*_test.js
*_test.cjs
test_*.js
test_*.cjs

# Debug files
debug.html

# ----------------------------------------
# Temporary / Generated files
# ----------------------------------------
.DS_Store
*.jpg
*.jpeg
*.gif
*.webp
*.bmp

# Keep documentation screenshots
!image-*.png
!**/image-*.png

# ----------------------------------------
# Misc
# ----------------------------------------
*.bak
*.tmp
*.temp
/personal
